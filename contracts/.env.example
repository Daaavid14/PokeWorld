# Required environment variables for deployment
# Copy this file to .env and fill in your values

# ── Deployer wallet ──────────────────────────────────────────
# Private key of the account that will deploy the contracts
# DO NOT commit a real private key to version control!
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# ── RPC endpoints ────────────────────────────────────────────
# Sepolia testnet — get a free RPC from Infura, Alchemy, or use public:
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# (Optional) Ethereum mainnet for production
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# ── Block explorer verification ──────────────────────────────
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_key

# ── Optional ─────────────────────────────────────────────────
# Set to "true" to generate a gas usage report after tests
REPORT_GAS=false
